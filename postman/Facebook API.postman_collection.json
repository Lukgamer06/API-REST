          ]
        }
      }
    },
    {
      "name": "Agregar comentario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201 y asocia el comentario al post', function () {",
              "    pm.response.to.have.status(201);",
              "    const comment = pm.response.json();",
              "    pm.expect(comment.post_id).to.eql(Number(pm.environment.get('postId')));",
              "    pm.expect(comment.author).to.eql('Ana Postman');",
              "    pm.environment.set('commentId', comment.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"author\": \"Ana Postman\",\n  \"content\": \"Comentario de prueba desde Postman.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/posts/{{postId}}/comments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "posts",
            "{{postId}}",
            "comments"
          ]
        }
      }
