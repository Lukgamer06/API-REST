{
  "info": {
    "_postman_id": "d2c843f1-57cc-4cd5-a9f2-76ca94148c72",
    "name": "API REST Tipo Facebook",
    "description": "Flujo de validación de publicaciones, imágenes, comentarios, Me gusta y respuestas de error. Importa también Facebook API - Local.postman_environment.json y selecciona ese entorno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crear publicación",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201 Created', function () { pm.response.to.have.status(201); });",
              "const post = pm.response.json();",
              "pm.test('Devuelve la publicación y sus relaciones vacías', function () {",
              "    pm.expect(post.id).to.be.a('number');",
              "    pm.expect(post.title).to.eql('Post desde Postman');",
              "    pm.expect(post.likes_count).to.eql(0);",
              "    pm.expect(post.comments).to.be.an('array').that.is.empty;",
              "    pm.expect(post.images).to.be.an('array').that.is.empty;",
              "});",
              "pm.environment.set('postId', post.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Post desde Postman\",\n  \"content\": \"Publicación de prueba para el taller.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "posts"
          ]
        }
      }
    },
    {
      "name": "Listar publicaciones",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Devuelve lista paginada con relaciones', function () {",
              "    pm.expect(body.data).to.be.an('array');",
              "    pm.expect(body).to.have.property('current_page');",
              "    const post = body.data.find((item) => item.id === Number(pm.environment.get('postId')));",
              "    pm.expect(post, 'la publicación creada aparece en la lista').to.exist;",
              "    pm.expect(post.comments).to.be.an('array');",
              "    pm.expect(post.images).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "posts"
          ]
        }
      }
    },
    {
      "name": "Consultar publicación",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 y el ID coincide', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get('postId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "posts",
