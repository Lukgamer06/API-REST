    {
      "name": "Crear publicación con varias imágenes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201 con dos imágenes almacenadas', function () {",
              "    pm.response.to.have.status(201);",
              "    const post = pm.response.json();",
              "    pm.expect(post.images).to.have.length(2);",
              "    post.images.forEach((image) => pm.expect(image.image_path).to.match(/^posts\\//));",
              "    pm.environment.set('imagePostId', post.id);",
              "    pm.environment.set('imagePath1', post.images[0].image_path);",
              "    pm.environment.set('imagePath2', post.images[1].image_path);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Post con imágenes de prueba",
              "type": "text"
            },
            {
              "key": "content",
              "value": "Archivos de prueba de la colección Postman.",
              "type": "text"
            },
            {
              "key": "images[]",
              "type": "file",
              "src": "postman/fixtures/sample.png"
            },
            {
              "key": "images[]",
              "type": "file",
              "src": "postman/fixtures/sample.png"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "posts"
          ]
        }
      }
    },
